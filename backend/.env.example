NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/fitness_saas

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

BCRYPT_SALT_ROUNDS=12

# AI workout generator — only one provider's key is required, matching AI_PROVIDER
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
